# Caddy auto-provisions and renews a Let's Encrypt certificate for {$DOMAIN}
# on first request. Requires ports 80 + 443 open in the Lightsail firewall and
# a DNS A record pointing {$DOMAIN} at the instance's static IP.

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy web:3000
}


{
  "name": "web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently -k -n web,cctp,indexer,verify -c blue,magenta,green,yellow \"pnpm run dev\" \"pnpm run cctp:worker\" \"pnpm run indexer:worker\" \"pnpm run verification:worker\"",
    "build": "next build",
    "lint": "next lint",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "biome:check": "biome check .",
    "biome:fix": "biome check --write .",
    "format": "biome format --write .",
    "migrate:status": "node -- scripts/run-migrations.mjs status",
    "migrate:up": "node -- scripts/run-migrations.mjs up",
    "migrate:down": "node -- scripts/run-migrations.mjs down",
    "migrate:create": "migrate-mongo create -f migrate-mongo-config.cjs",
    "fee-policy:set": "node --env-file=.env.local scripts/set-client-fee-policy.mjs",
    "storage:initialize": "node scripts/initialize-pool-storage.mjs",
    "storage:reset": "node scripts/reset-pool-storage.mjs",
    "readiness:testnet": "jiti scripts/check-testnet-readiness.mjs",
    "cctp:worker": "node --env-file=.env.local scripts/cctp-worker.mjs",
    "cctp:sessions": "node --env-file=.env.local scripts/cctp-sessions.mjs",
    "indexer:worker": "node --env-file=.env.local scripts/pool-indexer.mjs",
    "verification:worker": "node --env-file=.env.local scripts/verification-worker.mjs",
    "verification:cases": "node --env-file=.env.local scripts/verification-cases.mjs",
    "test:e2e": "playwright test",
    "test:verification-ui": "node scripts/verify-onboarding-browser.mjs",
    "test:e2e:report": "playwright show-report artifacts/verification-qa/playwright-report"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@creit.tech/stellar-wallets-kit": "^2.5.0",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.4.0",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@openzeppelin/relayer-plugin-channels": "^0.20.0",
    "@privy-io/node": "^0.27.0",
    "@privy-io/react-auth": "^3.35.2",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.4",
    "@stellar/stellar-sdk": "^14.2.0",
    "@sumsub/websdk": "2.9.0",
    "@sumsub/websdk-react": "2.9.0",
    "@tanstack/react-query": "^5",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "circomlibjs": "^0.1.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "js-sha3": "^0.9.3",
    "jspdf": "^4.2.1",
    "lenis": "^1.3.25",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.21.0",
    "motion": "^12.43.0",
    "next": "^15.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.13.0",
    "snarkjs": "^0.7.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "viem": "2.52.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3",
    "concurrently": "^10.0.5",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "happy-dom": "^20.10.6",
    "migrate-mongo": "^14.0.7",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.7.2",
    "vitest": "^3"
  }
}

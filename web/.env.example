# Optional: isolates pool-specific collections while keeping one Mongo database.
MONGO_POOL_STORAGE_SCOPE=

CHANNELS_API_KEY=

CHANNELS_BASE_URL=https://channels.openzeppelin.com/testnet

NEXT_PUBLIC_CCTP_INTAKE_CONTRACT=
CCTP_OPERATOR_SECRET=
CIRCLE_IRIS_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=
FEE_QUOTE_SIGNING_SECRET=
# Route gate. deploy-testnet.sh writes an eligible/uncertified manifest and a fresh session key;
# certify-testnet.mjs certify-routes flips certified=true after the CCTP cases pass.
CCTP_ROUTE_MANIFEST=
CCTP_SESSION_KEY=
CCTP_WORKER_ENABLED=false
# Optional JSON map of source domain -> https RPC URLs (1-3 each), e.g. {"0":["https://sepolia.example"],"6":["https://base-sepolia.example"]}
CCTP_SOURCE_RPC_URLS=
CCTP_IRIS_TIMEOUT_MS=10000
CCTP_IRIS_RPS=10
# Local settlement loop (pnpm cctp:worker) targets this origin.
OLIO_BASE_URL=http://localhost:3000
CCTP_WORKER_INTERVAL_MS=15000
NEXT_PUBLIC_CCTP_TOKEN_MESSENGER_MINTER=CDNG7HXAPBWICI2E3AUBP3YZWZELJLYSB6F5CC7WLDTLTHVM74SLRTHP

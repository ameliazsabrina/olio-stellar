# MongoDB Atlas connection string. The db name comes from the URI path (/olio).
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/olio?retryWrites=true&w=majority

# Long random bearer token the pool-indexer cron must present.
CRON_SECRET=replace-with-a-long-random-secret
PRIVY_APP_ID=
PRIVY_APP_SECRET=
OLIO_WALLET_DEPLOYER_SECRET=
OLIO_ACCOUNT_WASM_HASH=

# OpenZeppelin Channels relayer.
CHANNELS_API_KEY=
CHANNELS_BASE_URL=https://channels.openzeppelin.com/testnet

# CCTP operator + Circle Iris.
CCTP_OPERATOR_SECRET=
CIRCLE_IRIS_URL=https://iris-api-sandbox.circle.com
CIRCLE_API_KEY=
